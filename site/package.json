{
  "name": "side-a-download",
  "version": "0.5.7",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:model": "node scripts/prepare-model.mjs && node scripts/prepare-discovery.mjs",
    "dev": "npm run prepare:model && vite --host 127.0.0.1",
