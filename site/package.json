    "test": "node --test tests/release.test.mjs tests/framing.test.mjs tests/discovery.test.mjs tests/analytics.test.mjs"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "0.185.4",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
